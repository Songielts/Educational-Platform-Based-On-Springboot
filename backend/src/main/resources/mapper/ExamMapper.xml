<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartedu.modules.exam.mapper.ExamMapper">

    <resultMap id="BaseResultMap" type="com.smartedu.modules.exam.entity.Exam">
        <id column="id" property="id"/>
        <result column="exam_name" property="examName"/>
        <result column="teacher_id" property="teacherId"/>
        <result column="course_id" property="courseId"/>
        <result column="class_id" property="classId"/>
        <result column="exam_type" property="examType"/>
        <result column="total_score" property="totalScore"/>
        <result column="pass_score" property="passScore"/>
        <result column="time_limit" property="timeLimit"/>
        <result column="question_count" property="questionCount"/>
        <result column="allow_retry" property="allowRetry"/>
        <result column="max_retry_count" property="maxRetryCount"/>
        <result column="shuffle_questions" property="shuffleQuestions"/>
        <result column="shuffle_options" property="shuffleOptions"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="status" property="status"/>
        <result column="deleted" property="deleted"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectTeacherExamPage" resultMap="BaseResultMap">
        SELECT * FROM edu_exam
        WHERE teacher_id = #{teacherId}
        AND (deleted = 0 OR deleted IS NULL)
        <if test="keyword != null and keyword != ''">
            AND exam_name LIKE CONCAT('%', #{keyword}, '%')
        </if>
        ORDER BY create_time DESC
    </select>

    <!-- 关键修复：给 start_time OR 条件加了括号 -->
    <select id="selectAvailableExamsForStudent" resultMap="BaseResultMap">
        SELECT e.*
        FROM edu_exam e
        WHERE e.status = 1
        AND (e.deleted = 0 OR e.deleted IS NULL)
        AND (
        e.end_time IS NULL
        OR e.end_time &gt; NOW()
        )
        AND (e.start_time IS NULL OR e.start_time &lt;= NOW())
        AND e.question_count &gt; 0
        AND NOT EXISTS (
        SELECT 1 FROM study_exam_record r
        WHERE r.exam_id = e.id
        AND r.student_id = #{studentId}
        AND (r.deleted = 0 OR r.deleted IS NULL)
        AND r.status IN (1, 2)
        )
        ORDER BY e.create_time DESC
    </select>

    <select id="selectStudentRecordPage" resultMap="BaseResultMap">
        SELECT e.*
        FROM edu_exam e
        INNER JOIN study_exam_record r ON e.id = r.exam_id
        WHERE r.student_id = #{studentId}
        AND (r.deleted = 0 OR r.deleted IS NULL)
        ORDER BY r.create_time DESC
    </select>

</mapper>